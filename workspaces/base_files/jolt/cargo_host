[package]
version = "0.1.0"
name = "host"
edition = "2021"

[features]
default = []
gpu = ["jolt-sdk/gpu"]

[dependencies]
guest = { path = "../program" }
jolt-sdk = { git = "https://github.com/a16z/jolt", features = ["host"] }

serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
bincode = "1.3"
tracing = "0.1"
tracing-subscriber = "0.3"