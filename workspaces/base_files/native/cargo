[package]
name = "native_runner"
version = "0.1.0"
edition = "2021"

[dependencies]
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
bincode = "1.3"

# Add common dependencies that the examples might use
sha2 = "0.10"
sha3 = "0.10"
hex = "0.4"
rand = "0.8"
num-bigint = "0.4"
num-traits = "0.2"
regex = "1.10"
k256 = "0.13"
p256 = "0.13"
rsa = "0.9"
ed25519-dalek = "2.1"

[[bin]]
name = "native_runner"
path = "src/main.rs"

